ENVIRONMENT=development
# Defaults to SQLite at backend/tracker.db. Production: postgresql+psycopg://user:pass@host/db
# DATABASE_URL=
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_ORIGIN=http://localhost:5180
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# First admin, created by `python -m app.cli ensure-admin` (the Docker image runs it on every start)
# if no user has this email yet. The password must be changed at first login.
# ADMIN_EMAIL=you@company.com
# ADMIN_NAME=Your Name
# ADMIN_PASSWORD=
